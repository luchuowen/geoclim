# Runtime config for lib/firestore.ts.
#
# On Firebase App Hosting / Cloud Run, firebase-admin's Application Default
# Credentials auto-detect the GCP project from the runtime metadata server —
# none of this is needed there.
#
# It's only needed for local development against the Firestore emulator
# (`firebase emulators:start --only firestore`), which has no real project
# to infer from:

# Required only when running against the Firestore emulator locally.
# Set by the emulator/firebase CLI (`firebase emulators:exec` sets this for
# you); set it yourself if you run `next dev` against a standalone emulator.
FIRESTORE_EMULATOR_HOST=localhost:8080

# The GCP/Firebase project id. Only read when FIRESTORE_EMULATOR_HOST is
# set (see lib/firestore.ts) — any placeholder value works for the
# emulator, since no real project is contacted.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
